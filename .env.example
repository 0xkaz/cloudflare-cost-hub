# Secret used to sign session cookies (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-random-secret

# --- Cloudflare OAuth ("Sign in with Cloudflare", self-managed PKCE client) ---
# Create the client in the Cloudflare dashboard. No client secret is needed for
# a public/PKCE client. See README for the full setup.
CF_OAUTH_CLIENT_ID=your-cloudflare-oauth-client-id
CF_OAUTH_REDIRECT_URI=http://localhost:8787/api/auth/cf/callback
# AES-GCM key (base64, 32 bytes) used to encrypt stored OAuth tokens at rest
# (generate with: openssl rand -base64 32). Set as a Worker secret in production.
TOKEN_ENC_KEY=change-me-to-a-base64-32-byte-key
# Optional: request the "User Details: Read" scope so /user returns the real
# verified email. Leave unset to fall back to an account-derived identity.
# CF_OAUTH_EXTRA_SCOPES=user-details.read

# Cloudflare account ID (for wrangler deploy)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Cloudflare Analytics API token + account for LIVE cost/usage data on the
# dashboard. Set these as Worker secrets/vars (not committed). When unset, the
# dashboard renders demo data. The token needs "Account Analytics: Read".
CF_ANALYTICS_TOKEN=your-cloudflare-analytics-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_ACCOUNT_NAME=My Cloudflare Account

# Public base URL of this deployment, used for links in alert emails.
APP_URL=https://your-domain.example.com

# Email alerts via Resend (daily digest). RESEND_API_KEY is a Worker secret.
RESEND_API_KEY=your-resend-api-key
ALERT_EMAIL_FROM=Cloudflare Cost Hub <noreply@example.com>
# Fallback recipient used only when no user has configured per-user alerts.
ALERT_EMAIL_TO=you@example.com
# Monetization flag. Unset/"false": every enabled user receives alerts.
# "true": automated alerts require a paid plan (user_alert_settings.plan).
ALERTS_REQUIRE_PAYMENT=false
